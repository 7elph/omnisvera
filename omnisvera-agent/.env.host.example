# Copy to .env.host; leave defaults when host-data was restored beside this file.
# Paths must be absolute when running as a service. Environment overrides this file.
# OMNISVERA_VAULT_PATH=/srv/omnisvera/omnisvera-agent/host-data/vault
# OMNISVERA_DB_PATH=/srv/omnisvera/omnisvera-agent/host-data/state/companion.sqlite3
# OMNISVERA_TOKEN_FILE=/srv/omnisvera/omnisvera-agent/host-data/state/access_tokens.json
# OMNISVERA_AI_WORKSHOP_DB=/srv/omnisvera/omnisvera-agent/host-data/state/ai-workshop.sqlite3
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gpt-oss:120b-cloud
OMNISVERA_REBUILD_ON_STARTUP=false
OMNISVERA_AUTO_REFRESH_INDEX=false
