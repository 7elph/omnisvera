{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/gpt-oss:120b-cloud",
  "small_model": "ollama/gpt-oss:120b-cloud",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Cloud via localhost",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "gpt-oss:120b-cloud": {
          "name": "GPT-OSS 120B Cloud",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 131072, "output": 32768 }
        }
      }
    }
  },
  "instructions": ["AGENTS.md", "docs/AI_TEST_TOOLS.md"],
  "mcp": {
    "companion-tests": {
      "type": "local",
      "command": [".venv-observer/Scripts/python.exe", "backend/scripts/companion_test_mcp.py"],
      "enabled": true,
      "timeout": 15000
    }
  }
}
