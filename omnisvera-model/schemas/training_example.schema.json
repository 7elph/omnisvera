{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnisvera.local/schemas/training-example-1.0.json",
  "title": "Omnisvera Training Example 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "schema_version", "created_at", "updated_at", "source_type",
    "category", "access_profile", "persona_id", "instruction",
    "retrieved_context", "ideal_response", "facts_expected", "theories_allowed",
    "must_not_reveal", "insufficient_information_expected", "requires_rag",
    "contains_canon", "contains_secret", "entity_ids", "source_note_ids",
    "source_note_hashes", "review_status", "reviewer", "quality_score",
    "dataset_split", "dataset_version", "notes"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 3},
    "schema_version": {"const": "1.0"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "source_type": {"enum": ["real_chat", "corrected_chat", "synthetic_candidate", "manual"]},
    "category": {"type": "string", "minLength": 2},
    "access_profile": {"enum": ["player", "gm", "system"]},
    "persona_id": {"type": ["string", "null"]},
    "instruction": {"type": "string", "minLength": 2},
    "retrieved_context": {"type": "array", "items": {"type": "object"}},
    "ideal_response": {"type": "string"},
    "facts_expected": {"type": "array", "items": {"type": "string"}},
    "theories_allowed": {"type": "array", "items": {"type": "string"}},
    "must_not_reveal": {"type": "array", "items": {"type": "string"}},
    "insufficient_information_expected": {"type": "boolean"},
    "requires_rag": {"type": "boolean"},
    "contains_canon": {"type": "boolean"},
    "contains_secret": {"type": "boolean"},
    "entity_ids": {"type": "array", "items": {"type": "string"}},
    "source_note_ids": {"type": "array", "items": {"type": "string"}},
    "source_note_hashes": {"type": "array", "items": {"type": "string"}},
    "review_status": {"enum": ["captured", "pending", "approved", "rejected"]},
    "reviewer": {"type": ["string", "null"]},
    "quality_score": {"type": ["integer", "null"], "minimum": 0, "maximum": 2},
    "dataset_split": {"enum": ["train", "eval", "frozen_eval", null]},
    "dataset_version": {"type": ["string", "null"]},
    "notes": {"type": ["string", "null"]}
  }
}
